{
  "name":"entego-pwa",
  "main":"./api-worker.js",
  "compatibility_date":"2026-08-12",
  "assets":{
    "directory":"./dist",
    "binding":"ASSETS",
    "not_found_handling":"single-page-application",
    "run_worker_first":["/api/*"]
  },
  "durable_objects":{
    "bindings":[
      {"name":"ENT_STORE","class_name":"EntegoStore"},
      {"name":"ENT_AUTH","class_name":"EntegoAuth"},
      {"name":"ENT_PAY","class_name":"EntegoPayment"},
      {"name":"ENT_PARTNER","class_name":"EntegoPartner"}
    ]
  },
  "exports":{
    "EntegoStore":{"type":"durable-object","storage":"sqlite"},
    "EntegoAuth":{"type":"durable-object","storage":"sqlite"},
    "EntegoPayment":{"type":"durable-object","storage":"sqlite"},
    "EntegoPartner":{"type":"durable-object","storage":"sqlite"}
  }
}
