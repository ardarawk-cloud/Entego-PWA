{
  "name":"entego-pwa",
  "main":"./worker.js",
  "compatibility_date":"2026-08-12",
  "assets":{
    "directory":"./dist",
    "binding":"ASSETS",
    "not_found_handling":"single-page-application",
    "run_worker_first":["/api/*"]
  },
  "durable_objects":{
    "bindings":[
      {"name":"ENT_STORE","class_name":"EntegoStore"}
    ]
  },
  "exports":{
    "EntegoStore":{
      "type":"durable-object",
      "storage":"sqlite"
    }
  }
}
